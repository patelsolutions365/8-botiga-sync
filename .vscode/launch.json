{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Botiga Sync API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Botiga Sync API",
      "program": "${workspaceFolder}/BotigaSync.API/bin/Debug/net8.0/BotigaSync.API.dll",
      "cwd": "${workspaceFolder}/BotigaSync.API",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:5122"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
